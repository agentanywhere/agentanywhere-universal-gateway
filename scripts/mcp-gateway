#!/usr/bin/env python3
"""Convenience launcher for the AgentAnywhere Universal Gateway CLI.

This wrapper lets you use the CLI without installing the package:

    chmod +x scripts/mcp-gateway
    ./scripts/mcp-gateway --help

If you've installed the project (``pip install -e .``), prefer the
installed ``mcp-gateway`` console script instead.
"""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from app.cli.main import main


if __name__ == "__main__":
    raise SystemExit(main())
