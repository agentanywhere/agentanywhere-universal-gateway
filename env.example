# =============================================================================
# AgentAnywhere Universal Gateway Configuration
# =============================================================================
# Copy this file to .env and update with your values
# cp env.example .env

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=AgentAnywhere Universal Gateway
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000
# Docker Compose publishes every port (except nginx's 80/443) on 127.0.0.1 by default,
# so the gateway is not reachable from other machines except through nginx.
# Set BIND_ADDRESS=0.0.0.0 only if you really want that (it bypasses nginx).
# BIND_ADDRESS=127.0.0.1
WORKERS=4
# Optional: Override gateway URL base (useful for production with load balancers)
# If not set, will be constructed from HOST:PORT
# GATEWAY_URL_BASE=https://gateway.example.com

# NOTE: some names below still say "mcp-gateway" (log paths, service names).
# The project used to be called MCP Gateway; the MCP_GATEWAY_* variables and the
# mcp_gateway.plugins entry point are compatibility aliases and are read by
# those exact names. They are left as they are on purpose.

# =============================================================================
# Security Configuration
# =============================================================================
# Generate a strong secret key: python3 scripts/generate_secret_key.py
# SECRET_KEY signs nothing in this release. It is a break-glass credential:
# accepted as an API key on the data plane, and as the admin credential while
# ADMIN_TOKEN is empty. The placeholder below is never accepted.
SECRET_KEY=change-me-in-production-use-strong-random-key-min-32-chars
# Admin API and admin console credential. Leave empty to use SECRET_KEY instead.
# Once ADMIN_TOKEN is set, SECRET_KEY no longer opens the admin API.
# With ADMIN_TOKEN empty AND the placeholder SECRET_KEY above, the admin API
# rejects everything: there is no default password.
ADMIN_TOKEN=
# true: accept SECRET_KEY on the admin API even when ADMIN_TOKEN is set (the
# behaviour before this setting existed). Leave false.
ADMIN_ACCEPT_SECRET_KEY=false
# Username expected by the admin console's local sign-in form.
ADMIN_USERNAME=admin
# Not used yet: nothing in this release issues or signs tokens with these.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key
# Reverse proxies in front of the gateway (IPs or CIDR ranges, comma-separated
# or a JSON array). X-Forwarded-For is only read when the connection comes from
# one of them, from the right. Empty: the header is ignored and the socket peer
# is the client address. Behind the bundled nginx, set it to nginx's address
# (under Docker Compose, the gateway-network subnet).
# TRUSTED_PROXIES=10.0.0.5,172.18.0.0/16
TRUSTED_PROXIES=

# =============================================================================
# CORS Configuration
# =============================================================================
# Browser origins allowed to call the gateway, as a JSON array or a
# comma-separated list (true of every list setting). The default
# below is the admin console on this machine (port 3001, both `npm run dev`
# in admin-ui/ and docker-compose.yml). Replace or extend it with the exact
# origins of your front ends, e.g.
# CORS_ORIGINS=["https://console.example.com"]
# "*" allows every origin; the gateway then turns CORS_ALLOW_CREDENTIALS off
# (browsers refuse "*" together with credentials) and logs a warning.
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# Retention
# =============================================================================
# Delete request log rows older than this many days (0 = keep forever).
# Pruning runs at start-up and then every RETENTION_INTERVAL_HOURS.
REQUEST_LOG_RETENTION_DAYS=0
RETENTION_INTERVAL_HOURS=24

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_SOCKET_TIMEOUT=1.0
# Counters go to Redis when this is set. Comment it out to keep them in each
# process's memory instead (correct for a single process only).
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# Database Configuration
# =============================================================================
# Leave DATABASE_URL unset to use the default SQLite file:
#   outside Docker: sqlite+aiosqlite:///./gateway.db (relative to the working directory)
#   docker-compose.yml: sqlite+aiosqlite:////app/data/gateway.db, on the
#   gateway_data volume, so it survives the container being recreated.
# Setting it here applies to both. Under Docker Compose, a relative SQLite path
# here would put the database inside the container, where it is lost.
# DATABASE_URL=sqlite+aiosqlite:///./gateway.db

# PostgreSQL (for production). With docker-compose.yml use the service name
# "postgres" as the host, not localhost.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gateway
# POSTGRES_DB=gateway
# POSTGRES_USER=gateway_user
# Required for the `production` profile of docker-compose.yml; PostgreSQL
# refuses to start while it is empty or starts with change-me.
# POSTGRES_PASSWORD=
# POSTGRES_PORT=5432

# =============================================================================
# Backend Service URLs
# =============================================================================
# These are for running the gateway directly on this machine (uvicorn), next
# to the sample backends on localhost.
# docker-compose.yml does NOT use the MCP/A2A/HTTP/WebSocket/MQTT/gRPC/GraphQL
# lines below: inside the container, localhost is the gateway itself. Compose
# points those backends at the sample services of the `backends` profile
# (http://mcp-backend:8001 and so on). To use your own backends under Compose,
# set the DOCKER_ variants instead, for example:
# DOCKER_MCP_BACKEND_URL=http://10.0.0.5:8001
# DOCKER_A2A_BACKEND_URL=
# DOCKER_HTTP_BACKEND_URL=
# DOCKER_WEBSOCKET_BACKEND_URL=
# DOCKER_MQTT_BROKER_URL=
# DOCKER_GRPC_BACKEND_URL=
# DOCKER_GRAPHQL_BACKEND_URL=
MCP_BACKEND_URL=http://localhost:8001
A2A_BACKEND_URL=http://localhost:8002
# AG-UI (Agent-GUI streaming surfaces) and ACP (Agent Communication Protocol)
# backends are optional; set them to enable /agui and /acp routing.
# Sample backends: samples/backends/agui (8004) and samples/backends/acp (8005).
AG_UI_BACKEND_URL=
ACP_BACKEND_URL=
HTTP_BACKEND_URL=http://localhost:8003
MQTT_BROKER_URL=mqtt://localhost:1883
WEBSOCKET_BACKEND_URL=ws://localhost:8080
GRPC_BACKEND_URL=localhost:50051
# Sample GraphQL backend: samples/backends/graphql (http://localhost:8006/graphql)
GRAPHQL_BACKEND_URL=http://localhost:4000/graphql
DEFAULT_TIMEOUT=30

# =============================================================================
# Logging Configuration
# =============================================================================
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Format: json | text | auto (auto picks text on TTY, json otherwise)
LOG_FORMAT=json
# Probabilistic sampling for INFO logs (0.0 = drop all, 1.0 = keep all).
# WARNING/ERROR/CRITICAL and access logs with status_code >= 400 are always kept.
LOG_SAMPLING_RATE=1.0
# Redact secrets/PII (Bearer tokens, API keys, password fields, JWTs, ...)
LOG_REDACTION_ENABLED=true
# Include filename / line / function in every log record (more verbose, slower)
LOG_INCLUDE_CALLER=false
# Optional: also write rotating JSON log files
# LOG_FILE_PATH=/var/log/mcp-gateway/gateway.log
# LOG_AUDIT_FILE_PATH=/var/log/mcp-gateway/audit.log
# Quieter or louder third-party loggers, as logger=LEVEL pairs
# LOG_LEVEL_OVERRIDES=uvicorn.access=WARNING,httpx=WARNING
# Extra field names to redact and extra regexes to scrub from values (comma-separated).
# These add to the built-in defaults.
# LOG_REDACT_KEYS=ssn,card_number
# LOG_REDACT_PATTERNS=\bAKIA[0-9A-Z]{16}\b
# Rotation for LOG_FILE_PATH / LOG_AUDIT_FILE_PATH
# LOG_FILE_MAX_BYTES=104857600
# LOG_FILE_BACKUP_COUNT=10
# Fields on every line: host.name and process.pid; timestamp as iso or epoch
# LOG_INCLUDE_HOSTNAME=true
# LOG_INCLUDE_PROCESS_INFO=true
# LOG_TIMESTAMP_FORMAT=iso
# Access logs with a status at or above this are never sampled out
# LOG_SAMPLE_ALWAYS_STATUS_GE=400
# Print a summary of the configuration to stderr when the gateway is ready
# STARTUP_BANNER=true
# Request-log rows: inline (one write per request), batched (bounded queue, one transaction per
# batch) or off. See docs/reference/configuration.md before using batched or off.
# REQUEST_LOG_MODE=inline
# REQUEST_LOG_BATCH_SIZE=200
# REQUEST_LOG_FLUSH_INTERVAL=0.25
# REQUEST_LOG_QUEUE_SIZE=20000
# SQLite only: WAL with NORMAL is the usual choice when several workers share one file.
# SQLITE_JOURNAL_MODE=WAL
# SQLITE_SYNCHRONOUS=NORMAL
# SQLITE_BUSY_TIMEOUT_MS=5000
# Cache validated API keys and their tenant in each worker's memory when Redis is not used (0 = off).
# A key revoked through another worker can still be accepted until the entry expires.
# API_KEY_LOCAL_CACHE_TTL_SECONDS=5
# Per-request anomaly detection and usage analytics (several ms of CPU per request).
# AI_ANALYTICS_ENABLED=true
# Swappable parts of the request path: a built-in name, or "module:attribute" for your own.
# JSON_CODEC=stdlib
# UPSTREAM_CLIENT=httpx
# ANALYTICS_ADAPTER=full
# REQUEST_LOG_SINK=database
# Documentation link shown in that banner (point it at your own docs site)
# DOCUMENTATION_URL=https://docs.agentanywhere.ai/gateway/

# =============================================================================
# Optional: load configuration from a YAML / JSON / TOML file
# =============================================================================
# CONFIG_FILE=/etc/mcp-gateway/config.yaml
# Precedence: built-in defaults < CONFIG_FILE < .env < environment variables

# =============================================================================
# Observability — OpenTelemetry tracing
# =============================================================================
# Set to true to forward in-process spans to an OTel collector via OTLP/HTTP.
OTEL_TRACING_ENABLED=false
# OTel collector endpoint (e.g. http://otel-collector:4318/v1/traces).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated headers added to OTLP requests (e.g. authorization=Bearer xxx).
OTEL_EXPORTER_OTLP_HEADERS=
# Service name attribute for emitted spans.
OTEL_SERVICE_NAME=agentanywhere-gateway

# =============================================================================
# Log Export Buffer / Worker
# =============================================================================
LOG_EXPORT_ENABLED=false
LOG_EXPORT_BATCH_SIZE=100
LOG_EXPORT_FLUSH_INTERVAL=5.0
LOG_EXPORT_MAX_QUEUE_SIZE=10000

# =============================================================================
# Log Export Configuration (Elasticsearch)
# =============================================================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=gateway-logs
ELASTICSEARCH_ENABLED=false

# =============================================================================
# Log Export Configuration (Splunk)
# =============================================================================
SPLUNK_URL=https://splunk.example.com:8088
SPLUNK_TOKEN=your-splunk-token
SPLUNK_INDEX=gateway
SPLUNK_ENABLED=false

# =============================================================================
# Log Export Worker (background batching)
# =============================================================================
LOG_EXPORT_BATCH_SIZE=100
LOG_EXPORT_FLUSH_INTERVAL=5.0
LOG_EXPORT_MAX_QUEUE_SIZE=10000

# =============================================================================
# Log Export Configuration (AWS S3)
# =============================================================================
S3_LOG_EXPORT_ENABLED=false
S3_LOG_BUCKET=
S3_LOG_PREFIX=gateway-logs/
S3_LOG_REGION=us-east-1

# =============================================================================
# Log Export Configuration (AWS CloudWatch Logs)
# =============================================================================
CLOUDWATCH_LOGS_ENABLED=false
CLOUDWATCH_LOG_GROUP=
CLOUDWATCH_LOG_STREAM=
CLOUDWATCH_REGION=us-east-1

# Shared AWS credentials (optional; otherwise uses default credential chain)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# Log Export Configuration (Datadog)
# =============================================================================
DATADOG_LOGS_ENABLED=false
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_SERVICE=mcp-gateway
DATADOG_SOURCE=python
DATADOG_TAGS=env:production,team:platform

# =============================================================================
# Log Export Configuration (AWS S3 + CloudWatch)
# =============================================================================
# Shared AWS credentials (optional; falls back to default boto3 chain)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 archive of gateway logs as gzipped NDJSON objects
S3_LOG_EXPORT_ENABLED=false
S3_LOG_BUCKET=
S3_LOG_PREFIX=gateway-logs/
S3_LOG_REGION=us-east-1

# CloudWatch Logs (real-time stream)
CLOUDWATCH_LOGS_ENABLED=false
CLOUDWATCH_LOG_GROUP=mcp-gateway
CLOUDWATCH_LOG_STREAM=gateway-1
CLOUDWATCH_REGION=us-east-1

# =============================================================================
# Log Export Configuration (Datadog)
# =============================================================================
DATADOG_LOGS_ENABLED=false
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_SERVICE=mcp-gateway
DATADOG_SOURCE=python
DATADOG_TAGS=env:production,team:platform

# =============================================================================
# Email Notification Configuration
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@gateway.com
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_ALERT_RECIPIENTS=admin@example.com,alerts@example.com  # Comma-separated list
EMAIL_RATE_LIMIT_PER_HOUR=50  # Maximum emails per hour to prevent spam

# =============================================================================
# Slack Notification Configuration
# =============================================================================
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=  # https://hooks.slack.com/services/T000/B000/XXX
SLACK_CHANNEL=#alerts  # Optional channel override
SLACK_USERNAME=AgentAnywhere Gateway
SLACK_ICON_EMOJI=:rotating_light:
SLACK_RATE_LIMIT_PER_HOUR=60

# Alert Thresholds Configuration
ALERT_THRESHOLD_RATE_LIMIT=true  # Enable rate limit alerts
ALERT_THRESHOLD_CIRCUIT_BREAKER=true  # Enable circuit breaker alerts
ALERT_THRESHOLD_ANOMALY_SCORE=0.7  # Minimum anomaly score to trigger alert (0.0-1.0)
ALERT_THRESHOLD_ERROR_RATE=0.1  # Error rate threshold (10% = 0.1) to trigger high error rate alert
ALERT_THRESHOLD_TRAFFIC_SPIKE=2.0  # Traffic spike multiplier (2.0 = 2x normal traffic)
ALERT_THRESHOLD_MIN_INTERVAL_SECONDS=300  # Minimum interval between same-type alerts (5 minutes)

# =============================================================================
# Slack Notification Configuration
# =============================================================================
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T0/B0/XXX
SLACK_CHANNEL=#alerts
SLACK_USERNAME=AgentAnywhere Gateway
SLACK_ICON_EMOJI=:rotating_light:
SLACK_RATE_LIMIT_PER_HOUR=60

# =============================================================================
# Metrics & Monitoring
# =============================================================================
METRICS_ENABLED=true
METRICS_PATH=/metrics
# true: METRICS_PATH and /health/detailed need "Authorization: Bearer <admin
# credential>" (ADMIN_TOKEN, as for the admin API). Off by default so an
# unauthenticated Prometheus scrape keeps working; see prometheus.yml.
OPS_ENDPOINTS_REQUIRE_ADMIN=false

# =============================================================================
# Health Check
# =============================================================================
HEALTH_CHECK_PATH=/health

# =============================================================================
# Circuit Breaker Configuration
# =============================================================================
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# =============================================================================
# Protocol-Specific Default Settings
# =============================================================================
# The PROTOCOL_*_RATE_LIMIT_* values are not enforced yet: they are only
# reported by GET /admin/settings/protocols. Requests are limited per API key
# (RATE_LIMIT_PER_MINUTE / RATE_LIMIT_PER_HOUR and each key's own limits).
# MCP/A2A Protocol Defaults
PROTOCOL_MCP_RATE_LIMIT_PER_MINUTE=60
PROTOCOL_MCP_RATE_LIMIT_PER_HOUR=1000
PROTOCOL_A2A_RATE_LIMIT_PER_MINUTE=60
PROTOCOL_A2A_RATE_LIMIT_PER_HOUR=1000

# HTTP Protocol Defaults
PROTOCOL_HTTP_RATE_LIMIT_PER_MINUTE=100
PROTOCOL_HTTP_RATE_LIMIT_PER_HOUR=5000

# MQTT Protocol Defaults
PROTOCOL_MQTT_RATE_LIMIT_PER_MINUTE=200
PROTOCOL_MQTT_RATE_LIMIT_PER_HOUR=10000
PROTOCOL_MQTT_DEFAULT_PORT=1883
PROTOCOL_MQTT_KEEP_ALIVE=60

# WebSocket Protocol Defaults
PROTOCOL_WEBSOCKET_RATE_LIMIT_PER_MINUTE=300
PROTOCOL_WEBSOCKET_RATE_LIMIT_PER_HOUR=15000
PROTOCOL_WEBSOCKET_MAX_CONNECTIONS=500
PROTOCOL_WEBSOCKET_KEEP_ALIVE=30

# gRPC Protocol Defaults
PROTOCOL_GRPC_RATE_LIMIT_PER_MINUTE=150
PROTOCOL_GRPC_RATE_LIMIT_PER_HOUR=8000
PROTOCOL_GRPC_KEEPALIVE_TIME_MS=30000
PROTOCOL_GRPC_KEEPALIVE_TIMEOUT_MS=5000
PROTOCOL_GRPC_MIN_TIME_BETWEEN_PINGS_MS=10000
PROTOCOL_GRPC_MIN_PING_INTERVAL_WITHOUT_DATA_MS=300000

# =============================================================================
# Admin UI Configuration
# =============================================================================
# The two lines below are not read by the gateway or by docker-compose.yml
# (the Compose file publishes the console on 3001 as written). They are
# placeholders for your own deployment tooling.
ADMIN_UI_PORT=3001
ADMIN_UI_URL=http://localhost:3001

# =============================================================================
# Nginx Configuration (Production)
# =============================================================================
# Not read by the gateway or by docker-compose.yml; used only by your own
# deployment tooling, if at all. The nginx service in docker-compose.yml is
# selected with `--profile production`, not with these variables.
NGINX_ENABLED=false
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
SSL_CERT_PATH=./nginx/ssl/cert.pem
SSL_KEY_PATH=./nginx/ssl/key.pem

# =============================================================================
# Prometheus & Grafana (Monitoring Profile)
# =============================================================================
# The four lines below (PROMETHEUS_*, GRAFANA_ENABLED, GRAFANA_PORT) are not
# read by the gateway or by docker-compose.yml; used only by your own
# deployment tooling, if at all. Prometheus and Grafana start with
# `--profile monitoring`, on the ports written in docker-compose.yml.
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=false
GRAFANA_PORT=3000
# Read only by docker-compose.yml, for the Grafana admin password of the
# `monitoring` profile. Required for that profile: Grafana refuses to start
# while it is empty or "admin". The gateway does not read it.
GRAFANA_ADMIN_PASSWORD=

# =========================================================================
# Dynamic routes (POST /admin/routes)
# =========================================================================
# When enabled, a route registered through the admin API is honoured at
# request time and takes precedence over the static prefix routing above.
# Matching is done against an in-memory snapshot (no per-request DB work).
# Set to false to pin the gateway to static prefix routing only.
DYNAMIC_ROUTES_ENABLED=true
# How often replicas reload the route table to converge on admin edits.
# The worker that handles the write applies it immediately.
DYNAMIC_ROUTES_REFRESH_SECONDS=15

# =========================================================================
# Optional, off by default. See docs/reference/configuration.md before enabling.
# =========================================================================
# OpenID Connect sign-in for the admin console (RS256 access tokens).
# IDA_ISSUER=https://sso.example.com/realms/demo
# IDA_ADMIN_AUDIENCE=gateway-admin
# IDA_ADMIN_ROLES=platform_admin,tenant_admin
# Agent edge: /agents/<slug>/... is forwarded to the slug's upstream WITHOUT
# gateway API-key checks; the upstream must authenticate its own callers.
# AGENT_EDGE_ENABLED=false
# AGENT_ROUTES_JSON={"orders-agent":"http://10.0.0.10:8090"}
